{
  "manifest_version": 3,
  "name": "Hình nền ASCII cho Claude",
  "version": "0.1.0",
  "description": "Hình nền chuyển động vẽ bằng ký tự phía sau claude.ai, khung chat dạng kính mờ.",
  "permissions": ["storage"],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Hình nền chuyển động",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["scenes.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
